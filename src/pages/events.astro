---
import Layout from "../layouts/Layout.astro";
import EventModal from "../components/EventModal.astro";
import { Image } from "astro:assets";

interface Event {
  id: string;
  name: string;
  date: string;
  dateSort: Date; // For sorting
  image: string;
  fullDescription?: string;
  isPast?: boolean;
}

// Import all event images from Veranstaltungen directory
let imageImports: Record<string, () => Promise<{ default: string }>> = {};

imageImports = import.meta.glob(
  "/src/images/Veranstaltungen/*.{jpeg,jpg,png,gif,JPG}",
) as Record<string, () => Promise<{ default: string }>>;

// Create a mapping of image names to imported images
const imageMap: Record<string, string> = {};

// Process the imports directly from the paths
for (const [path, importFn] of Object.entries(imageImports)) {
  const fileName = path.split("/").pop()?.split(".")[0] || "";
  const imageModule = await importFn();
  imageMap[fileName] = imageModule.default;
}

// Sample events with past and future dates
const allEvents: Event[] = [
  {
    id: "inwm-2025",
    name: "Interkultureller Weihnachtsmarkt 2025",
    date: "6-8 Dezember jeweils 11-17 Uhr, 9-12 Dezember jeweils 12-17 Uhr, 13-14 Dezember jeweils 11-17 Uhr",
    dateSort: new Date("2025-12-08"),
    image: imageMap["Interkultureller_Weihnachtsmarkt_2025"] || "",
    fullDescription:
      "In unserem liebevoll gestalteten Weihnachtsmarkt werden handgefertigte Produkte aus den unterschiedlichsten Teilen der Welt angeboten: Wohndekor, dekorative Schals, tolle Ledertaschen, bunte Körbe, sinnliche Tee- und Kakao-Mischungen, zauberhafte Filzkreationen und Teeschalen, wunderschöne, reichlich bestickte Wandbehänge, Holzfiguren, Lampen, traditionelle Stoffe und Tücher und viele andere unverwechselbare Handarbeitskreationen – das alles aus Indien, Senegal, Syrien, Madagaskar, Marokko, Mali, Slowenien, Nepal und Österreich. Der kleine, feine, in jedem Fall aber außergewöhnliche Weihnachtsmarkt findet in Zusammenarbeit mit Künstlerinnen und Frauenorganisationen aus Indien, Afrika, Europa sowie Frauen aus der Region statt. Der Eintritt zum interkulturellen Weihnachtsmarkt ist frei.",
  },
  {
    id: "an-2023",
    name: "Adventmarkt Niederneukirchen 2023",
    date: "Dezember 2023",
    dateSort: new Date("2023-12-10"),
    image: imageMap["Adventmarkt_Niederneukirchen_2023"] || "",
    fullDescription:
      "In stimmungsvoller Adventatmosphäre präsentierte ich handgefertigte Taschen und feine Stickereien. Traditionelle Techniken wie Seidenbändchenstickerei und Zwirnknöpfe trafen auf moderne Designs. Viele Besucher:innen fanden hier ihr persönliches Lieblingsunikat als Geschenk.",
  },
  {
    id: "kb-2024",
    name: "Kreativmarkt Böllerbauer 2024",
    date: "22. - 23. März 2024",
    dateSort: new Date("2024-03-22"),
    image: imageMap["Kreativmarkt_Böllerbauer_2024"] || "",
    fullDescription:
      "Ein Wochenende voller Kreativität im Böllerbauer: Taschenunikate, Patchwork und Quilts standen im Mittelpunkt. Besonders beliebt waren die kunstvollen Details, die jedem Stück Individualität verleihen. Viele Gäste nutzten die Gelegenheit, meine Arbeiten in entspannter Atmosphäre zu entdecken.",
  },
  {
    id: "kg-2023",
    name: "Kreativmarkt Garsten 2023",
    date: "10. April 2023",
    dateSort: new Date("2023-04-10"),
    image: imageMap["Kreativmarkt_Garsten_2024"] || "",
    fullDescription:
      "Mit viel Freude präsentierte ich meine handgemachten Taschen und Stoffarbeiten in Garsten. Die Kombination aus traditionellem Handwerk und modernen Ideen begeisterte das Publikum. Ein kreativer Austausch mit vielen Besucher:innen machte den Markt für mich unvergesslich.",
  },
  {
    id: "kgs-2025",
    name: "Kreativmarkt beim Grünlandfest in Steyr",
    date: "28. Juni 2025",
    dateSort: new Date("2025-06-28"),
    image: imageMap["Kreativmarkt_Grünland_2025"] || "",
    fullDescription:
      "Beim fröhlichen Grünlandfest zeigten sich meine Taschen und Stickereien im sommerlichen Ambiente. Besonderen Anklang fanden farbenfrohe Patchwork-Designs passend zur Jahreszeit. Ein lebendiger Tag voller Begegnungen und Handwerkskunst im Herzen von Steyr.",
  },
  {
    id: "gbh-2025",
    name: "Kreativmarkt Böllerbauer in Haag",
    date: "30. - 31. August 2025",
    dateSort: new Date("2025-08-30"),
    image: imageMap["Kreativmarkt_Böllerbauer_2025"] || "",
    fullDescription:
      "Zwei Tage Kreativmarkt boten Raum, meine neuesten Taschenunikate und Stickereien zu präsentieren. Das Publikum schätzte die Kombination von altem Handwerk und frischem Design. Eine inspirierende Veranstaltung mit vielen interessanten Gesprächen.",
  },
  {
    id: "mats-2025",
    name: "Martinimarkt im Altersheim Tabor in Steyr",
    date: "1. November 2025",
    dateSort: new Date("2025-11-01"),
    image: imageMap["Martinimarkt_Tabor_2025"] || "",
    fullDescription:
      "Zum Martinimarkt bringe ich eine Auswahl liebevoll gefertigter Taschen und Handarbeiten mit. Die Verbindung von traditioneller Technik und modernem Design sorgt für einzigartige Stücke. Ein gemütlicher Markt, der zum Staunen und Verweilen einlädt.",
  },
  {
    id: "kg-2025",
    name: "Kreativmarkt in Garsten",
    date: "8. November 2025",
    dateSort: new Date("2025-11-08"),
    image: imageMap["christmas-market-past"] || "",
    fullDescription:
      "In vorweihnachtlicher Stimmung werde ich meine neuesten Taschenunikate und Stoffarbeiten zeigen. Jedes Werk trägt die Handschrift alter Handwerkskunst kombiniert mit frischer Kreativität. Eine wunderbare Gelegenheit, besondere Geschenke mit Herz zu entdecken.",
  },
  {
    id: "zw-2026",
    name: "Zwirnknopf Workshop 2026",
    date: "18. April 2026",
    dateSort: new Date("2026-04-18"),
    image: imageMap["Zwirnknopf_Workshop_2026"] || "",
    fullDescription:
      "Entdecke die alte Handwerkskunst des Zwirnknopfens und gestalte deine eigenen, einzigartigen Knöpfe! In diesem ganztägigen Workshop mit Claudia Wild lernst du Schritt für Schritt, wie aus Faden und Stoff kleine Kunstwerke entstehen – mit viel Herz, Kreativität und handwerklichem Geschick.",
  },
  {
    id: "nwm-2025",
    name: "4. Nachhaltiger Weihnachtsmarkt",
    date: "6. Dezember 2025 14-19 Uhr; 7. Dezember 2025 10-18 Uhr",
    dateSort: new Date("2025-12-06"),
    image: imageMap["Nachaltiger_Weihnachtsmarkt_2025"] || "",
    fullDescription:
      "Lass dich von der stimmungsvollen Atmosphäre des nachhaltigen Weihnachtsmarkts verzaubern! Hier erwarten dich liebevoll gefertigte Kunsthandwerke, regionale Spezialitäten und kreative Ideen voller Herzblut. Entdecke besondere Stücke, die Geschichten erzählen – und Menschen, die ihr Handwerk mit Leidenschaft leben.",
  },
];

// Sort events by date
allEvents.sort((a, b) => b.dateSort.getTime() - a.dateSort.getTime());
---

<Layout>
  <div class="w-full py-8 px-4">
    <!-- Center Navigation Buttons as Main Title -->
    <div class="text-center mb-12">
      <p
        class="font-pompiere text-2xl md:text-3xl text-gray-700 max-w-3xl mx-auto mb-8"
      >
        Hier findest du alle aktuellen und vergangenen Termine, wo du meine
        handgemachten Unikate in der Zukunft persönlich entdecken kannst.
      </p>

      <!-- Main Navigation Buttons -->
      <div class="flex justify-center md:gap-6 gap-3 mb-8">
        <button
          onclick="scrollToSection('future')"
          class="bg-white hover:bg-gray-50 text-gray-800 font-pompiere text-xl md:text-3xl px-4 py-4 rounded-lg border-2 border-gray-300 transition-all duration-200 shadow-md hover:shadow-lg transform hover:scale-105"
        >
          Kommende Veranstaltungen
        </button>
        <button
          onclick="scrollToSection('past')"
          class="bg-gray-100 hover:bg-gray-200 text-gray-800 font-pompiere text-xl md:text-3xl px-4 py-4 rounded-lg border-2 border-gray-300 transition-all duration-200 shadow-md hover:shadow-lg transform hover:scale-105"
        >
          Vergangene Veranstaltungen
        </button>
      </div>
    </div>

    <!-- All Events Rendered Together -->
    <div
      id="all-events-list"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      {
        allEvents.map((event) => (
          <div
            class="event-card bg-white rounded-lg shadow-md border-2 border-gray-300 overflow-hidden hover:shadow-lg transition-shadow duration-300 cursor-pointer"
            data-date={event.dateSort.toISOString()}
            onclick={`openEventModal('${event.id}')`}
          >
            <div
              class={
                "aspect-video flex items-center justify-center relative overflow-hidden " +
                (event.image ? "bg-gray-50" : "bg-gray-100 p-2")
              }
            >
              {event.image ? (
                <Image
                  src={event.image}
                  alt={event.name}
                  width={400}
                  height={225}
                  class="h-full w-full object-contain"
                  loading="lazy"
                />
              ) : (
                <div class="text-gray-700 font-pompiere text-lg text-center px-4">
                  {event.name}
                </div>
              )}
              <div class="absolute top-2 right-2 text-white text-xs px-2 py-1 rounded-full event-status" />
            </div>
            <div class="p-4">
              <h3 class="font-pompiere text-xl font-semibold mb-2">
                {event.name}
              </h3>
              <p class="text-gray-600 font-pompiere text-lg mb-2 font-medium">
                {event.date}
              </p>
              <button
                class="mt-4 w-full bg-white hover:bg-gray-50 text-gray-800 font-pompiere text-lg px-4 py-2 rounded border-2 border-gray-300 transition-colors duration-200"
                onclick={`openEventModal('${event.id}')`}
              >
                Mehr erfahren
              </button>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Future Events Section -->
    <section id="future" class="max-w-6xl mx-auto mb-16 pt-8">
      <h2
        class="text-3xl md:text-4xl font-pompiere text-center mb-8 text-gray-700"
      >
        Kommende Veranstaltungen
      </h2>
      <div
        id="future-events-list"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      >
      </div>
    </section>
    <!-- Past Events Section -->
    <section id="past" class="max-w-6xl mx-auto mb-16 pt-8">
      <h2
        class="text-3xl md:text-4xl font-pompiere text-center mb-8 text-gray-600"
      >
        Vergangene Veranstaltungen
      </h2>
      <div
        id="past-events-list"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      >
      </div>
    </section>
  </div>

  <!-- Event Modal Component -->
  <EventModal events={allEvents} />

  <!-- Smooth Scrolling & Dynamic Event Sorting Script -->
  <script is:inline>
    function scrollToSection(sectionId) {
      const element = document.getElementById(sectionId);
      if (element) {
        const header = document.getElementById("header");
        const headerHeight = header ? header.offsetHeight : 0;
        const elementPosition = element.getBoundingClientRect().top;
        const offsetPosition =
          elementPosition + window.pageYOffset - headerHeight;
        window.scrollTo({ top: offsetPosition, behavior: "smooth" });
      }
    }
    window.scrollToSection = scrollToSection;

    // Move event cards to correct section based on date
    const now = new Date();
    const allCards = Array.from(document.querySelectorAll(".event-card"));
    const futureList = document.getElementById("future-events-list");
    const pastList = document.getElementById("past-events-list");
    allCards.forEach((card) => {
      const eventDate = new Date(card.dataset.date);
      const statusDiv = card.querySelector(".event-status");
      if (eventDate < now) {
        card.classList.add("past");
        card.classList.remove("future");
        if (statusDiv) {
          statusDiv.textContent = "Vergangen";
          statusDiv.classList.add("bg-gray-500");
          statusDiv.classList.remove("bg-gray-700");
        }
        pastList.appendChild(card);
      } else {
        card.classList.add("future");
        card.classList.remove("past");
        if (statusDiv) {
          statusDiv.textContent = "Bevorstehend";
          statusDiv.classList.add("bg-gray-700");
          statusDiv.classList.remove("bg-gray-500");
        }
        futureList.appendChild(card);
      }
    });
    // Optionally hide the all-events-list container
    document.getElementById("all-events-list").style.display = "none";
  </script>
</Layout>
