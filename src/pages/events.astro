---
import Layout from "../layouts/Layout.astro";
import EventModal from "../components/EventModal.astro";
import { Image } from "astro:assets";
import eventsData from "../data/events.json";

// Import all event images from Veranstaltungen directory
const imageImports = import.meta.glob(
  "/src/images/Veranstaltungen/*.{jpeg,jpg,png,gif,JPG}",
) as Record<string, () => Promise<{ default: string }>>;

const imageMap: Record<string, string> = {};
for (const [path, importFn] of Object.entries(imageImports)) {
  const fileName = path.split("/").pop()?.split(".")[0] || "";
  const imageModule = await importFn();
  imageMap[fileName] = imageModule.default;
}

const allEvents = eventsData
  .map((event) => ({
    ...event,
    dateSort: new Date(event.dateSort),
    image: event.image ? (imageMap[event.image] || "") : "",
  }))
  .sort((a, b) => b.dateSort.getTime() - a.dateSort.getTime());
---

<Layout>
  <div class="w-full py-8 px-4">
    <!-- Center Navigation Buttons as Main Title -->
    <div class="text-center mb-12">
      <p
        class="font-pompiere text-2xl md:text-3xl text-gray-700 max-w-3xl mx-auto mb-8"
      >
        Hier findest du alle aktuellen und vergangenen Termine, wo du meine
        handgemachten Unikate in der Zukunft persönlich entdecken kannst.
      </p>

      <!-- Main Navigation Buttons -->
      <div class="flex justify-center md:gap-6 gap-3 mb-8">
        <button
          onclick="scrollToSection('future')"
          class="bg-white hover:bg-gray-50 text-gray-800 font-pompiere text-xl md:text-3xl px-4 py-4 rounded-lg border-2 border-gray-300 transition-all duration-200 shadow-md hover:shadow-lg transform hover:scale-105"
        >
          Kommende Veranstaltungen
        </button>
        <button
          onclick="scrollToSection('past')"
          class="bg-gray-100 hover:bg-gray-200 text-gray-800 font-pompiere text-xl md:text-3xl px-4 py-4 rounded-lg border-2 border-gray-300 transition-all duration-200 shadow-md hover:shadow-lg transform hover:scale-105"
        >
          Vergangene Veranstaltungen
        </button>
      </div>
    </div>

    <!-- All Events Rendered Together -->
    <div
      id="all-events-list"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      {
        allEvents.map((event) => (
          <div
            class="event-card bg-white rounded-lg shadow-md border-2 border-gray-300 overflow-hidden hover:shadow-lg transition-shadow duration-300 cursor-pointer"
            data-date={event.dateSort.toISOString()}
            onclick={`openEventModal('${event.id}')`}
          >
            <div
              class={
                "aspect-video flex items-center justify-center relative overflow-hidden " +
                (event.image ? "bg-gray-50" : "bg-gray-100 p-2")
              }
            >
              {event.image ? (
                <Image
                  src={event.image}
                  alt={event.name}
                  width={400}
                  height={225}
                  class="h-full w-full object-contain"
                  loading="lazy"
                />
              ) : (
                <div class="text-gray-700 font-pompiere text-lg text-center px-4">
                  {event.name}
                </div>
              )}
              <div class="absolute top-2 right-2 text-white text-xs px-2 py-1 rounded-full event-status" />
            </div>
            <div class="p-4">
              <h3 class="font-pompiere text-xl font-semibold mb-2">
                {event.name}
              </h3>
              <p class="text-gray-600 font-pompiere text-lg mb-2 font-medium">
                {event.date}
              </p>
              <button
                class="mt-4 w-full bg-white hover:bg-gray-50 text-gray-800 font-pompiere text-lg px-4 py-2 rounded border-2 border-gray-300 transition-colors duration-200"
                onclick={`openEventModal('${event.id}')`}
              >
                Mehr erfahren
              </button>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Future Events Section -->
    <section id="future" class="max-w-6xl mx-auto mb-16 pt-8">
      <h2
        class="text-3xl md:text-4xl font-pompiere text-center mb-8 text-gray-700"
      >
        Kommende Veranstaltungen
      </h2>
      <div
        id="future-events-list"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      >
      </div>
    </section>
    <!-- Past Events Section -->
    <section id="past" class="max-w-6xl mx-auto mb-16 pt-8">
      <h2
        class="text-3xl md:text-4xl font-pompiere text-center mb-8 text-gray-600"
      >
        Vergangene Veranstaltungen
      </h2>
      <div
        id="past-events-list"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      >
      </div>
    </section>
  </div>

  <!-- Event Modal Component -->
  <EventModal events={allEvents} />

  <!-- Smooth Scrolling & Dynamic Event Sorting Script -->
  <script is:inline>
    function scrollToSection(sectionId) {
      const element = document.getElementById(sectionId);
      if (element) {
        const header = document.getElementById("header");
        const headerHeight = header ? header.offsetHeight : 0;
        const elementPosition = element.getBoundingClientRect().top;
        const offsetPosition =
          elementPosition + window.pageYOffset - headerHeight;
        window.scrollTo({ top: offsetPosition, behavior: "smooth" });
      }
    }
    window.scrollToSection = scrollToSection;

    // Move event cards to correct section based on date
    const now = new Date();
    const allCards = Array.from(document.querySelectorAll(".event-card"));
    const futureList = document.getElementById("future-events-list");
    const pastList = document.getElementById("past-events-list");
    allCards.forEach((card) => {
      const eventDate = new Date(card.dataset.date);
      const statusDiv = card.querySelector(".event-status");
      if (eventDate < now) {
        card.classList.add("past");
        card.classList.remove("future");
        if (statusDiv) {
          statusDiv.textContent = "Vergangen";
          statusDiv.classList.add("bg-gray-500");
          statusDiv.classList.remove("bg-gray-700");
        }
        pastList.appendChild(card);
      } else {
        card.classList.add("future");
        card.classList.remove("past");
        if (statusDiv) {
          statusDiv.textContent = "Bevorstehend";
          statusDiv.classList.add("bg-gray-700");
          statusDiv.classList.remove("bg-gray-500");
        }
        futureList.appendChild(card);
      }
    });
    // Optionally hide the all-events-list container
    document.getElementById("all-events-list").style.display = "none";
  </script>
</Layout>
